{
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Screen Time Reminder Extension",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "notifications",
        "storage",
        "offscreen"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "icons": {
        "128": "assets/icon128px.png"
    },
    "background": {
        "service_worker": "background.js"
        }
}