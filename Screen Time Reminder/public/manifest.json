{
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Screen Time Reminder Extension",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "scripting",
        "tabs",
        "notifications",
        "storage",
        "alarms",
        "activeTab"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
        }
}